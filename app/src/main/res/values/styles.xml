<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Material 3 主题：品牌蓝作为主色 seed，顶栏/表面用 M3 surface，
         文字与图标走 on-surface，自动适配深浅，不再需要旧的 textColorPrimary=白 hack。 -->
    <style name="AppTheme" parent="Theme.Material3.DayNight">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/brand_on_primary</item>
        <item name="colorPrimaryContainer">@color/brand_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/brand_on_primary_container</item>
        <!-- AppCompat AlertDialog.Builder 走这个（Material3 对话框样式，日夜自适应） -->
        <item name="alertDialogTheme">@style/AppAlertDialog</item>
        <!-- MaterialAlertDialogBuilder 走这个 -->
        <item name="materialAlertDialogTheme">@style/AppMaterialAlertDialog</item>
        <!-- 状态栏/导航栏与顶栏统一为 M3 surface，图标明暗随日夜自适应
             （浅色→深图标、深色→白图标），解决浅色白底白图标看不清、
             以及主页/设置/编辑页状态栏颜色不一致 -->
        <item name="android:statusBarColor">?attr/colorSurface</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">@bool/is_light_theme</item>
        <item name="android:navigationBarColor">?attr/colorSurface</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">@bool/is_light_theme</item>
        <!-- Material 3 页面切换动效（fade through） -->
        <item name="android:windowAnimationStyle">@style/AppWindowAnimation</item>
        <!-- 关闭 Android 15 (API 35) 强制 edge-to-edge（低版本忽略此属性） -->
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item>
    </style>

    <style name="AppAlertDialog" parent="Theme.Material3.DayNight.Dialog.Alert" />
    <style name="AppMaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog" />

    <!-- 设置页沿用 M3 主题，文字色交给 M3 on-surface -->
    <style name="AppPreferenceTheme" parent="AppTheme" />
    <style name="AppPreferenceSettingsFragmentTheme" parent="@style/AppPreferenceTheme" />

    <!-- Material 3 页面切换：进入淡入+轻微放大、退出淡出（fade through） -->
    <style name="AppWindowAnimation" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/m3_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/m3_exit</item>
        <item name="android:activityCloseEnterAnimation">@anim/m3_pop_enter</item>
        <item name="android:activityCloseExitAnimation">@anim/m3_pop_exit</item>
    </style>

</resources>
